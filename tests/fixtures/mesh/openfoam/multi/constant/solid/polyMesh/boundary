FoamFile
{
    version     2.0;
    format      ascii;
    class       polyBoundaryMesh;
    location    "constant/solid/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

4
(
    movingWall
    {
        type            wall;
        inGroups        1(wall);
        nFaces          2;
        startFace       4;
    }
    fixedWalls
    {
        type            wall;
        inGroups        1(wall);
        nFaces          4;
        startFace       6;
    }
    frontAndBack
    {
        type            wall;
        inGroups        1(wall);
        nFaces          8;
        startFace       10;
    }
    solid_to_fluid
    {
        type            mappedWall;
        inGroups        1(wall);
        nFaces          2;
        startFace       18;
        sampleMode      nearestPatchFace;
        sampleRegion    fluid;
        samplePatch     fluid_to_solid;
    }
)

